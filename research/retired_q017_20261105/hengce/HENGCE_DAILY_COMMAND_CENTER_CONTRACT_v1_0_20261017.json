{
  "system": "HENGCE",
  "contract": "DAILY_COMMAND_CENTER",
  "version": "1.0",
  "effective_from": "2026-10-19",
  "principle": "DOWNLOAD_VERIFY_COMPUTE_OUTPUT",
  "hard_rules": {
    "no_required_data_no_signal": true,
    "no_stale_substitution": true,
    "no_future_data": true,
    "existing_eod_pipeline_remains_authoritative": true,
    "q017_radar_does_not_change_core_model": true,
    "top1_is_strongest_candidate_not_mandatory_trade": true,
    "always_show_top3_and_new_candidates": true
  },
  "daily_phases": {
    "premarket": {
      "requirements": ["latest completed SOX", "previous completed TWSE EOD three-leg status", "electronics beta history"],
      "outputs": ["DATA_STATUS", "SOX_1D", "SOX_5D", "MARKET_STATE"]
    },
    "post_open": {
      "requirements": ["premarket PASS", "current TWSE electronic quotes"],
      "outputs": ["TOP1", "TOP2", "TOP3", "NEW", "DROPPED", "QUALIFIED", "REJECTED"]
    },
    "position_tracking": {
      "rule": "candidate ranking continues even when positions exist",
      "outputs": ["position day count", "research D10 marker", "new market candidates"]
    },
    "post_close": {
      "requirements": ["price COMPLETE", "institutional COMPLETE", "margin COMPLETE"],
      "action_on_missing": "download missing required official data before analysis",
      "outputs": ["EOD_DATA_STATUS", "forward evidence", "next-session beta history update"]
    }
  },
  "q017_radar": {
    "scope": "TWSE listed electronics",
    "market_gate": {"sox_1d_max": 0.0, "sox_5d_max": -0.02},
    "beta": {"max_observations": 60, "min_observations": 30, "point_in_time": true},
    "residual_max": 0.04,
    "score": "beta * (1 + 25 * max(-residual, 0))",
    "ranking_count": 3,
    "research_hold_days": 10,
    "execution_research_anchor": {
      "decision_after_open": true,
      "boardlot": true,
      "fill_window_minutes": 20,
      "minute_participation_cap": 0.10,
      "slippage_stress": 0.002,
      "roundtrip_cost_stress": 0.006
    }
  },
  "authority": {
    "changes_live_holdings": false,
    "changes_forward_ledger_history": false,
    "changes_existing_eod_schema": false,
    "changes_core_ranking": false,
    "adds_market_radar": true,
    "adds_data_fail_closed_gate": true
  }
}
